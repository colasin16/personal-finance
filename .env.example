# Everything is optional: without these the app runs fully offline with local mocks.

# Session cookie signing secret (required in production)
AUTH_SECRET=change-me

# Postgres (e.g. Supabase). Unset => embedded PGlite at .data/pglite
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# PGLITE_DIR=.data/pglite

# Supabase Storage for PDFs. Unset => local filesystem at .data/uploads
# SUPABASE_URL=https://xyz.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=statements
# UPLOADS_DIR=.data/uploads

# Bank logos via Brandfetch Logo API (free client ID: https://developers.brandfetch.com/register).
# Unset => coloured lettermarks. Logos are hotlinked from cdn.brandfetch.io as Brandfetch requires.
# NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=
